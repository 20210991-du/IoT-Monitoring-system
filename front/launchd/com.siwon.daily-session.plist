<?xml version="1.0" encoding="UTF-8"?>
<!--
  매일 자정 (00:01) 2가지 작업 chain (1-1 + 2-1 통합):
    1) /api/admin/merge-yesterday-sessions
       → 어제 일반 세션들을 1개로 합침 (자동분석 🤖 제외)
       → title "📚 YYYY-MM-DD 대화 통합"
    2) /api/admin/ensure-daily-session
       → 오늘 빈 일일 세션 INSERT (📅 YYYY-MM-DD 대화)

  순서: merge 먼저 (어제 정리) → ensure (오늘 준비).
  자동분석 세션 (🤖 AI 자동 분석 — YYYY-MM-DD) 은 별도 ai-insight plist 가 관리.

  설치:
    cp ~/work/IoT-Monitoring-system/front/launchd/com.siwon.daily-session.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.siwon.daily-session.plist 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.siwon.daily-session.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.siwon.daily-session</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>echo "=== $(date) ===" ; curl -sS --max-time 30 -X POST http://localhost:5050/api/admin/merge-yesterday-sessions ; echo ; curl -sS --max-time 15 -X POST http://localhost:5050/api/admin/ensure-daily-session ; echo</string>
  </array>

  <!-- 매일 00:01 (자정 직후) 실행 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>1</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/pjh/daily-session.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/pjh/daily-session.log</string>
</dict>
</plist>
